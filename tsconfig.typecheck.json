// Typecheck-only config — used by `npm run typecheck`, NEVER read by Metro.
//
// spatch-kit lives outside this project (../spatch-kit) and ships no node_modules, so when tsc
// follows an @spatch-kit/* import into a kit file and that file imports `react` / `react-native` /
// etc., tsc's normal upward node_modules walk (rooted at the kit file, outside this app) never
// reaches this app's node_modules and the kit file fails to typecheck. Mapping the kit's runtime
// packages to THIS app's installed copies here fixes that — and maps them to the app's SINGLE
// @types/react so there's never a duplicate-React global-JSX clash.
//
// This MUST stay out of the base tsconfig.json: Expo's Metro reads tsconfig.json `paths` and applies
// them as bundler aliases, so a `react` path there aliases the real runtime react to the types-only
// @types/react package and breaks every native/web bundle. Keeping the mapping in a separate,
// script-only config is what lets typecheck resolve kit types without poisoning the build.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@spatch-kit/*": ["../spatch-kit/*"],
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime"],
      "react-dom": ["./node_modules/react-dom"],
      "react-native": ["./node_modules/react-native"],
      "nativewind": ["./node_modules/nativewind"],
      "react-native-reanimated": ["./node_modules/react-native-reanimated"],
      "react-native-safe-area-context": ["./node_modules/react-native-safe-area-context"],
      "react-native-gesture-handler": ["./node_modules/react-native-gesture-handler"],
      "react-native-svg": ["./node_modules/react-native-svg"],
      "@gorhom/portal": ["./node_modules/@gorhom/portal"],
      "@react-native-async-storage/async-storage": ["./node_modules/@react-native-async-storage/async-storage"],
      "lucide-react-native": ["./node_modules/lucide-react-native"],
      "expo-linear-gradient": ["./node_modules/expo-linear-gradient"],
      "expo-image-manipulator": ["./node_modules/expo-image-manipulator"],
      "expo-router/react-navigation": ["./node_modules/expo-router/react-navigation"]
    }
  }
}
