{
  "name": "dartscape",
  "version": "1.0.0",
  "main": "index",
  "dependencies": {
    "@gorhom/portal": "^1.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.6",
    "expo-constants": "~57.0.5",
    "expo-crypto": "~57.0.1",
    "expo-image-manipulator": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "lucide-react-native": "^1.24.0",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "tailwindcss": "^4.1.12",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "//": "lightningcss 1.32.0 breaks react-native-css 3.0.7's native visitor protocol ('failed to deserialize ... Specifier'), which kills Android/iOS bundling under NativeWind 5. Pin to 1.30.1, the version react-native-css was built against — same override spatchr uses.",
  "overrides": {
    "lightningcss": "1.30.1",
    "react-native-css": {
      "lightningcss": "1.30.1"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node scripts/sim.ts --",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome check --write src",
    "check": "npm run typecheck && npm run lint && npm test",
    "bundle": "expo export --platform android --output-dir .expo-export",
    "apk": "expo prebuild --platform android && cd android && ./gradlew assembleDebug",
    "verify": "npm run check && npm run bundle"
  },
  "private": true
}
